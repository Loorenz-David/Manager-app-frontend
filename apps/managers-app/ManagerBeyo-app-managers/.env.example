# Copy to `.env` for local development. Never commit the copy.

# Vite dev-server proxy target (server-side only, never in the browser bundle).
API_TARGET_URL=http://localhost:8000

# Browser-visible origins. Baked into the bundle at build time — never secrets.
# Empty in dev makes the browser use same-origin /api/... through Vite.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=http://localhost:8000

# Credentials for the Playwright suite. Use a throwaway local account — the
# previous values were committed to this public repo and are compromised.
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
