# Copy to `.env` for local development. Never commit the copy.

# Browser-visible API origin. Baked into the bundle at build time, so it must
# never hold a secret. Leave empty to make the app issue same-origin /api/...
# requests; set it to reach a backend on another host.
VITE_API_URL=http://localhost:8000

# Vite dev-server proxy target (server-side only, never in the browser bundle).
# When set, /api and /socket.io are proxied here during `npm run dev`.
API_TARGET_URL=http://localhost:8000

# "1" enables the MSW mock backend in dev. "0" talks to the real API.
VITE_FLOOR_MOCKS=0
