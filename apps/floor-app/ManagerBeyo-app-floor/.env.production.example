# Template for the production build's env file.
#
# The real `.env.production` is NOT in git. It lives untracked on the EC2 box at
# /var/www/managerbeyo-frontend-src/apps/floor-app/ManagerBeyo-app-floor/, where
# the deploy workflow builds. `git reset --hard origin/main` leaves untracked
# files in place, so it survives every deploy.
#
# It cannot be omitted: packages/api-client/src/env.ts validates VITE_API_URL as
# a required string and throws at module load if it is undefined.

# Empty on purpose — the kiosk is served from the same origin as its API, so
# requests go to /api/... and nginx proxies them to the backend.
VITE_API_URL=

VITE_FLOOR_MOCKS=0
