# Environment files. Real env files never enter git — the deploy builds on the
# EC2 box, so production values live in untracked files there (`git reset --hard`
# leaves untracked files alone). Only *.example templates are committed.
.env
.env.*
!.env.example
!.env.test.example
!.env.production.example

